import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { DefaultTheme } from 'vitepress'

const here = path.dirname(fileURLToPath(import.meta.url))
const apiIndex = path.resolve(here, '../../api/index.md')

function exists(file: string): boolean {
  try {
    return fs.statSync(file).isFile()
  } catch {
    return false
  }
}

function walk(dir: string, urlBase: string): DefaultTheme.SidebarItem[] {
  const entries = fs.readdirSync(dir, { withFileTypes: true })

  const pages = entries
    .filter((entry) => entry.isFile() && entry.name.endsWith('.md'))
    .map((entry) => entry.name.replace(/\.md$/, ''))
    .sort()
    .map((name) => ({ text: name, link: `${urlBase}/${name}` }))

  const dirs = entries
    .filter((entry) => entry.isDirectory())
    .map((entry) => entry.name)
    .sort()
    .map((name) => ({
      text: name,
      collapsed: true,
      items: walk(path.join(dir, name), `${urlBase}/${name}`)
    }))

  return [...pages, ...dirs]
}

/**
 * Sidebar for pages generated by `scripts/ci/gen-api-docs.py`.
 *
 * Returns an empty list when the pages have not been generated, so a plain
 * `vitepress build` without the CI step still works.
 */
function buildApiSidebar(): DefaultTheme.SidebarItem[] {
  if (!exists(apiIndex)) {
    return []
  }

  const root = path.dirname(apiIndex)
  const projects = fs
    .readdirSync(root, { withFileTypes: true })
    .filter((entry) => entry.isDirectory())
    .map((entry) => entry.name)
    .sort()

  return projects.map((project) => ({
    text: project,
    collapsed: true,
    items: walk(path.join(root, project), `/api/${project}`)
  }))
}

export const api_sidebar_items: DefaultTheme.SidebarItem[] = buildApiSidebar()

export const api_index: DefaultTheme.SidebarItem | null = exists(apiIndex)
  ? {
      text: 'API 参考',
      link: '/api/',
      collapsed: false,
      items: api_sidebar_items
    }
  : null
